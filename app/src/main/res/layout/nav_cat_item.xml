<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/spacing_8"
    app:cardCornerRadius="@dimen/corner_radius_large"
    app:cardElevation="@dimen/elevation_medium">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/gradient_bg"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="@dimen/spacing_12">

        <!-- Category Image -->
        <ImageView
            android:id="@+id/cat_nav_img"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:scaleType="centerCrop"
            android:src="@drawable/fruits"
            android:layout_marginEnd="@dimen/spacing_12" />

        <!-- Category Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Category Name -->
            <TextView
                android:id="@+id/nav_cat_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Category Name"
                android:textSize="@dimen/text_size_headline_small"
                android:textStyle="bold"
                android:textColor="@color/neutral_99"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginBottom="@dimen/spacing_4" />

            <!-- Description -->
            <TextView
                android:id="@+id/nav_cat_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Description"
                android:textSize="@dimen/text_size_body_small"
                android:textColor="@color/neutral_80"
                android:maxLines="2"
                android:ellipsize="end"
                android:layout_marginBottom="@dimen/spacing_12" />

            <!-- Discount Badge -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/tertiary"
                android:paddingStart="@dimen/spacing_12"
                android:paddingEnd="@dimen/spacing_12"
                android:paddingTop="@dimen/spacing_4"
                android:paddingBottom="@dimen/spacing_4"
                app:cornerRadius="@dimen/corner_radius_medium">

                <TextView
                    android:id="@+id/nav_cat_discount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="20% OFF"
                    android:textSize="@dimen/text_size_label_large"
                    android:textStyle="bold"
                    android:textColor="@color/on_tertiary" />
            </LinearLayout>
        </LinearLayout>

        <!-- Arrow Icon -->
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_baseline_arrow_forward_ios_24"
            android:scaleType="centerInside"
            android:layout_marginStart="@dimen/spacing_12"
            app:tint="@color/neutral_99" />

    </LinearLayout>

</androidx.cardview.widget.CardView>