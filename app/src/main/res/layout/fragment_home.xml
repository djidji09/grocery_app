<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".ui.home.HomeFragment">

    <ProgressBar
        android:id="@+id/progressbar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Search Bar -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/search_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/spacing_16"
                app:boxBackgroundColor="@color/neutral_10"
                app:boxCornerRadiusBottomEnd="@dimen/corner_radius_large"
                app:boxCornerRadiusBottomStart="@dimen/corner_radius_large"
                app:boxCornerRadiusTopEnd="@dimen/corner_radius_large"
                app:boxCornerRadiusTopStart="@dimen/corner_radius_large"
                app:boxStrokeColor="@color/primary"
                app:boxStrokeWidth="0dp"
                app:endIconMode="clear_text">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/search_box"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/search_bar_height"
                    android:hint="Search products..."
                    android:textColor="@color/neutral_99"
                    android:textSize="@dimen/text_size_body_large"
                    android:drawableStart="@drawable/ic_baseline_search_24"
                    android:drawablePadding="@dimen/spacing_12"
                    android:paddingStart="@dimen/spacing_16" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Popular Products Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="@dimen/spacing_16"
                android:paddingEnd="@dimen/spacing_16"
                android:paddingTop="@dimen/spacing_12"
                android:weightSum="2">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Popular Products"
                    android:textSize="@dimen/text_size_headline_small"
                    android:textStyle="bold"
                    android:textColor="@color/neutral_99" />

                <TextView
                    android:id="@+id/view_all_popular"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="View All"
                    android:gravity="end"
                    android:textSize="@dimen/text_size_body_medium"
                    android:textColor="@color/primary"
                    android:textStyle="bold" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/pop_rec"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/spacing_8"
                android:paddingStart="@dimen/spacing_8"
                android:paddingEnd="@dimen/spacing_8" />

            <!-- Explore Products Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="@dimen/spacing_16"
                android:paddingEnd="@dimen/spacing_16"
                android:paddingTop="@dimen/spacing_16"
                android:weightSum="2">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Explore Categories"
                    android:textSize="@dimen/text_size_headline_small"
                    android:textStyle="bold"
                    android:textColor="@color/neutral_99" />

                <TextView
                    android:id="@+id/view_all_explore"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="View All"
                    android:gravity="end"
                    android:textSize="@dimen/text_size_body_medium"
                    android:textColor="@color/primary"
                    android:textStyle="bold" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/explore_rec"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/spacing_8"
                android:paddingStart="@dimen/spacing_8"
                android:paddingEnd="@dimen/spacing_8" />

            <!-- Recommended Products Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="@dimen/spacing_16"
                android:paddingEnd="@dimen/spacing_16"
                android:paddingTop="@dimen/spacing_16"
                android:weightSum="2">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Recommended Products"
                    android:textSize="@dimen/text_size_headline_small"
                    android:textStyle="bold"
                    android:textColor="@color/neutral_99" />

                <TextView
                    android:id="@+id/view_all_recommended"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="View All"
                    android:gravity="end"
                    android:textSize="@dimen/text_size_body_medium"
                    android:textColor="@color/primary"
                    android:textStyle="bold" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recommended_rec"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/spacing_8"
                android:paddingStart="@dimen/spacing_8"
                android:paddingEnd="@dimen/spacing_8"
                android:paddingBottom="@dimen/spacing_16" />

        </LinearLayout>
    </ScrollView>
</RelativeLayout>