<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".ui.profile.ProfileFragment">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_16"
            android:paddingEnd="@dimen/spacing_16"
            android:paddingTop="@dimen/spacing_16">

            <!-- Profile Header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Profile Settings"
                android:textSize="@dimen/text_size_headline_large"
                android:textColor="@color/neutral_99"
                android:textStyle="bold"
                android:layout_marginBottom="@dimen/spacing_24" />

            <!-- Profile Image Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_24"
                app:cardCornerRadius="@dimen/corner_radius_large"
                app:cardElevation="@dimen/elevation_medium">

                <ImageView
                    android:id="@+id/profile_img"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:src="@drawable/profile"
                    android:scaleType="centerCrop" />
            </androidx.cardview.widget.CardView>

            <!-- Profile Form Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_24"
                app:cardCornerRadius="@dimen/corner_radius_large"
                app:cardElevation="@dimen/elevation_medium">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_20">

                    <!-- Name Field -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_16"
                        app:boxBackgroundColor="@color/neutral_10"
                        app:boxCornerRadiusBottomEnd="@dimen/corner_radius_medium"
                        app:boxCornerRadiusBottomStart="@dimen/corner_radius_medium"
                        app:boxCornerRadiusTopEnd="@dimen/corner_radius_medium"
                        app:boxCornerRadiusTopStart="@dimen/corner_radius_medium"
                        app:boxStrokeColor="@color/primary"
                        app:boxStrokeWidth="1dp"
                        app:hintTextColor="@color/primary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/profile_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Your Name"
                            android:textColor="@color/neutral_99"
                            android:drawableStart="@drawable/ic_baseline_person_24"
                            android:drawablePadding="@dimen/spacing_12"
                            android:textSize="@dimen/text_size_body_large" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Email Field -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_16"
                        app:boxBackgroundColor="@color/neutral_10"
                        app:boxCornerRadiusBottomEnd="@dimen/corner_radius_medium"
                        app:boxCornerRadiusBottomStart="@dimen/corner_radius_medium"
                        app:boxCornerRadiusTopEnd="@dimen/corner_radius_medium"
                        app:boxCornerRadiusTopStart="@dimen/corner_radius_medium"
                        app:boxStrokeColor="@color/primary"
                        app:boxStrokeWidth="1dp"
                        app:hintTextColor="@color/primary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/profile_email"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Your Email"
                            android:inputType="textEmailAddress"
                            android:textColor="@color/neutral_99"
                            android:drawableStart="@drawable/account"
                            android:drawablePadding="@dimen/spacing_12"
                            android:textSize="@dimen/text_size_body_large" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Phone Field -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_16"
                        app:boxBackgroundColor="@color/neutral_10"
                        app:boxCornerRadiusBottomEnd="@dimen/corner_radius_medium"
                        app:boxCornerRadiusBottomStart="@dimen/corner_radius_medium"
                        app:boxCornerRadiusTopEnd="@dimen/corner_radius_medium"
                        app:boxCornerRadiusTopStart="@dimen/corner_radius_medium"
                        app:boxStrokeColor="@color/primary"
                        app:boxStrokeWidth="1dp"
                        app:hintTextColor="@color/primary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/profile_number"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Phone Number"
                            android:inputType="phone"
                            android:textColor="@color/neutral_99"
                            android:drawableStart="@drawable/ic_baseline_local_phone_24"
                            android:drawablePadding="@dimen/spacing_12"
                            android:textSize="@dimen/text_size_body_large" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Address Field -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:boxBackgroundColor="@color/neutral_10"
                        app:boxCornerRadiusBottomEnd="@dimen/corner_radius_medium"
                        app:boxCornerRadiusBottomStart="@dimen/corner_radius_medium"
                        app:boxCornerRadiusTopEnd="@dimen/corner_radius_medium"
                        app:boxCornerRadiusTopStart="@dimen/corner_radius_medium"
                        app:boxStrokeColor="@color/primary"
                        app:boxStrokeWidth="1dp"
                        app:hintTextColor="@color/primary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/profile_address"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Your Address"
                            android:inputType="text"
                            android:textColor="@color/neutral_99"
                            android:drawableStart="@drawable/ic_baseline_location_on_24"
                            android:drawablePadding="@dimen/spacing_12"
                            android:textSize="@dimen/text_size_body_large" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Update Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/update"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:text="Update Profile"
                android:textStyle="bold"
                android:textSize="@dimen/text_size_label_large"
                android:layout_marginBottom="@dimen/spacing_24"
                app:cornerRadius="@dimen/corner_radius_medium"
                app:backgroundTint="@color/primary" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>